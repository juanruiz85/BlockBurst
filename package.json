{
  "name": "blockburst",
  "version": "0.5.4",
  "private": true,
  "description": "Shooter de arena con bloques de colores para navegador: 6 mapas, 5 modos y bots con IA.",
  "keywords": ["juego", "shooter", "webgl", "threejs", "canvas", "voxel"],
  "license": "MIT",
  "author": "Juan Ruiz",
  "scripts": {
    "check": "node tools/check-syntax.js",
    "validate": "node tools/validate-maps.js",
    "simulate": "node tools/simulate.js",
    "test": "node tools/check-syntax.js && node tools/validate-maps.js && node tools/simulate.js && node tools/build-single.js",
    "serve": "node tools/serve.js",
    "capture": "node tools/screenshot.js",
    "nettest": "node tools/nettest.js",
    "roomtest": "node tools/roomtest.js",
    "mqtttest": "node tools/mqtttest.js",
    "killchrome": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/kill-chrome.ps1",
    "build:single": "node tools/build-single.js"
  },
  "engines": {
    "node": ">=18"
  }
}
